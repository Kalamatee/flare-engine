#
#  This is the AROS specific top level mmakefile to build
#

include $(SRCDIR)/config/aros.cfg

FLARENGINE_EXEDIR := $(AROS_CONTRIB)/Games/Rpg/Flare

NOWARN_FLAGS := $(NOWARN_ERROR) $(NOWARN_MISLEADING_INDENTATION) $(NOWARN_MAYBE_UNINITIALIZED) $(NOWARN_NONNULL_COMPARE) $(NOWARN_ENUM_COMPARE)
NOWARN_CXXFLAGS := $(NOWARN_CLASS_MEMACCESS)

USER_INCLUDES := -I$(AROS_CONTRIB_INCLUDES)
USER_CFLAGS := $(NOWARN_FLAGS) $(CPPFLAGS)
USER_CXXFLAGS := \
                $(CFLAGS_FAST_MATH) -fomit-frame-pointer $(CFLAG_EXCEPTIONS) $(NOWARN_FLAGS) $(NOWARN_CXXFLAGS) $(CPPFLAGS)
USER_LDFLAGS := -L$(AROS_CONTRIB_LIB) -static-libstdc++

#MM- aros-flare-engine-libs : contrib-curl contrib-sdl2 development-SDL2_image-quick development-SDL2_mixer-quick development-SDL2_ttf-quick

#MM aros-flare-engine : aros-flare-engine-libs iconset-Gorilla-contrib-icons-extras-games-aflare-engine iconset-Gorilla-contrib-games-flare-enginegame

SDL2AROS_INCLUDES := $(AROS_INCLUDES)/SDL2

FLARENGINE_OPTIONS := \
        -DSDL2_LIBRARY=$(AROS_LIB)/libSDL2.a \
        -DSDL2_INCLUDE_DIR=$(SDL2AROS_INCLUDES) \
        -DSDL2_IMAGE_LIBRARY=$(AROS_LIB)/libSDL2_image.a \
        -DSDL2_IMAGE_INCLUDE_DIR=$(SDL2AROS_INCLUDES) \
        -DSDL2_MIXER_LIBRARY=$(AROS_LIB)/libSDL2_mixer.a \
        -DSDL2_MIXER_INCLUDE_DIR=$(SDL2AROS_INCLUDES) \
        -DSDL2_TTF_LIBRARY=$(AROS_LIB)/libSDL2_ttf.a \
        -DSDL2_TTF_INCLUDE_DIR=$(SDL2AROS_INCLUDES)

#FLARENGINE_OPTIONS += \
#  -DCMAKE_VERBOSE_MAKEFILE=ON

%build_with_cmake mmake=aros-flare-engine                  \
    prefix="$(FLARENGINE_EXEDIR)"                        \
    extraoptions="$(FLARENGINE_OPTIONS)" usecppflags=no

%common
